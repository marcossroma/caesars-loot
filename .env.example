# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Supabase pooled/runtime connection. Required in production.
DATABASE_URL=postgresql://postgres.example:password@host:6543/postgres?sslmode=require
# Supabase direct connection used by migrations.
DIRECT_URL=postgresql://postgres.example:password@host:5432/postgres?sslmode=require
# Optional isolated database used only by integration tests.
TEST_DATABASE_URL=
DATABASE_POOL_MAX=10
# Optional official CA certificate path, relative to the server workspace.
DATABASE_SSL_CA_FILE=
# Optional development-only latency simulation. Ignored in production.
DEV_API_DELAY_MS=0

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000/game
