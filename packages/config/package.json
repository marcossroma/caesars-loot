{
  "name": "@caesars-loot/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/theme.js",
  "types": "./dist/theme.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --passWithNoTests --pool=threads --maxWorkers=1",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "latest",
    "vitest": "latest"
  }
}
